---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';

const focusAreas = [
  'Deep learning and machine learning',
  'NLP, LLMs and generative AI',
  'Retrieval-augmented generation and document intelligence',
  'Data engineering and ETL/ELT',
  'MLOps and production AI',
  'CUDA and GPU optimization',
  'Open-source contributions',
];
---
<BaseLayout title="Salam AlKaissi — AI Engineer" description="About Salam AlKaissi, AI Engineer, Machine Learning Engineer and Data Scientist." active="about">
  <div class="about-layout">
    <ProfileSidebar />
    <article class="about-content">
      <section class="intro-copy" aria-label="About Salam">
        <p>I am an AI Engineer, Machine Learning Engineer and Data Scientist with more than seven years of experience across Data and Engineering. I hold an MSc in Data Science and have a Computer Engineering background.</p>
        <p>My work spans deep learning and machine learning, natural language processing, large language models and generative AI. I am interested in building practical AI systems, including retrieval-augmented generation and document intelligence. I am also interested in the engineering that supports these systems.</p>
        <p>My experience also includes data engineering, ETL/ELT, MLOps, production AI and CUDA/GPU optimization. I contribute to open-source projects and enjoy sharing technical knowledge.</p>
      </section>
      <section class="content-section">
        <h2>Beyond Engineering</h2>
        <p>I have taught educational robotics using LEGO Mindstorms EV3 and NXT, introducing students to programming and hands-on robotics.</p>
      </section>
      <section class="content-section interests-section">
        <h2>Areas of Interest</h2>
        <ul class="interest-list">{focusAreas.map((area) => <li>{area}</li>)}</ul>
      </section>
      <div class="collaboration-note">
        <p class="meta-label">DATA · ENGINEERING · AI</p>
        <p>More about my work is available on the <a href="/projects/">Projects page</a>.</p>
      </div>
    </article>
  </div>
</BaseLayout>
