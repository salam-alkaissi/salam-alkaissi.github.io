---
type Props = { active: 'about' | 'projects' };
const { active } = Astro.props;
---
<header class="site-header">
  <div class="header-inner page-width">
    <a class="brand" href="/" aria-label="Salam Alkaissi, About Me">
      <span class="brand-name">Salam Alkaissi</span>
      <span class="brand-tagline">AI • MACHINE LEARNING • PARIS</span>
    </a>
    <nav class="top-nav" aria-label="Main navigation">
      <a href="/" aria-current={active === 'about' ? 'page' : undefined} class:list={{ active: active === 'about' }}>About</a>
      <a href="/projects/" aria-current={active === 'projects' ? 'page' : undefined} class:list={{ active: active === 'projects' }}>Projects</a>
      <a class="nav-extra" href="https://drive.google.com/file/d/1V_fKwhQM8bUo950CCwKYLO2_5xbxxCh_/view?usp=drive_link" target="_blank" rel="noreferrer">CV</a>
      <a class="nav-extra" href="https://github.com/salam-alkaissi" target="_blank" rel="noreferrer">GitHub</a>
      <a class="nav-extra" href="https://www.linkedin.com/in/salam-alkaissi" target="_blank" rel="noreferrer">LinkedIn</a>
    </nav>
  </div>
</header>
